use org.openflexo.ta.java.AlloyModelSlot as ALLOY;
use org.openflexo.ta.java.PamelaModelSlot as PAMELA;
use org.openflexo.ta.java.RepositoryModelSlot as
 JAVA_REPO;
use org.openflexo.ta.java.FileModelSlot as JAVA;

/* A VirtualModel mapping Alloy and Pamela sources */
model CyberContractMapping {
  AlloySourceRepository alloySources with
    ALLOY::AlloyModelSlot();
  PamelaSourceRepository pamelaSources with
    PAMELA::PamelaModelSlot();
  SourceRepository javaSources with
    JAVA_REPO::RepositoryModelSlot(jdk="Java11+");
}